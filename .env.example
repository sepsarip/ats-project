# Global compose defaults
NODE_ENV=development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ats_db
DB_USER=ats_user
DB_PASSWORD=change_me

# node-pg-migrate
DATABASE_URL=postgres://ats_user:change_me@postgres:5432/ats_db

# Backend
BACKEND_PORT=5000
JWT_SECRET=replace_with_strong_secret
JWT_EXPIRES_IN=1d
AI_SERVICE_URL=http://ai-service:5001

# Frontend
FRONTEND_PORT=3000

# AI service
AI_SERVICE_PORT=5001
FLASK_ENV=production

GOOGLE_EMAIL_USER=EMAIL_ADDRESS
GOOGLE_APP_PASSWORD="PASSWORD"

FRONTEND_URL=http://localhost:3000